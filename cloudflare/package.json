{
  "name": "procurecorp-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create procurecorp-db",
    "db:migrate": "wrangler d1 execute procurecorp-db --file=../src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute procurecorp-db --local --file=../src/db/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
